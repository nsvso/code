<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>MAX ❤️</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
overflow:hidden;
height:100vh;
display:flex;
justify-content:center;
align-items:center;
font-family:Arial,Helvetica,sans-serif;
background:linear-gradient(-45deg,#000428,#004e92,#2b1055,#1f1c18);
background-size:400% 400%;
animation:bg 15s ease infinite;
}

@keyframes bg{
0%{background-position:0% 50%;}
50%{background-position:100% 50%;}
100%{background-position:0% 50%;}
}

.stars{
position:absolute;
width:100%;
height:100%;
overflow:hidden;
}

.star{
position:absolute;
width:2px;
height:2px;
background:white;
border-radius:50%;
animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{
from{opacity:.2;transform:scale(1);}
to{opacity:1;transform:scale(2);}
}

h1{
position:absolute;
font-size:120px;
font-weight:bold;
letter-spacing:10px;
background:linear-gradient(90deg,#ff0000,#ff8800,#ffee00,#00ff00,#00ffff,#0066ff,#ff00ff);
background-size:600%;
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
animation:
rainbow 6s linear infinite,
bounce 2s ease-in-out infinite,
glow 2s infinite;
text-shadow:0 0 30px #fff;
}

@keyframes rainbow{
0%{background-position:0%;}
100%{background-position:600%;}
}

@keyframes bounce{
0%,100%{transform:translateY(0);}
50%{transform:translateY(-25px);}
}

@keyframes glow{
0%,100%{
filter:drop-shadow(0 0 10px #fff);
}
50%{
filter:drop-shadow(0 0 35px hotpink);
}
}

.message{
position:absolute;
top:70%;
font-size:40px;
font-weight:bold;
color:white;
animation:slide 10s linear infinite;
white-space:nowrap;
text-shadow:0 0 20px hotpink;
}

@keyframes slide{
0%{left:-100%;}
100%{left:100%;}
}

.emoji{
position:absolute;
font-size:35px;
pointer-events:none;
animation:float linear forwards;
}

@keyframes float{
0%{
transform:translateY(0) rotate(0deg);
opacity:1;
}
100%{
transform:translateY(-120vh) rotate(720deg);
opacity:0;
}
}

.footer{
position:absolute;
bottom:20px;
font-size:25px;
color:white;
text-shadow:0 0 10px cyan;
animation:pulse 2s infinite;
}

@keyframes pulse{
0%,100%{transform:scale(1);}
50%{transform:scale(1.2);}
}
</style>

</head>

<body>

<div class="stars" id="stars"></div>

<h1>MAX</h1>

<div class="message">
💖 Ingat Palagi 💖
</div>

<div class="footer">
🎉💖✨🌹🥰🎂 HAPPY VIBES ONLY 🎂🥰🌹✨💖🎉
</div>

<script>

const starBox=document.getElementById("stars");

for(let i=0;i<300;i++){

let s=document.createElement("div");

s.className="star";

s.style.left=Math.random()*100+"vw";

s.style.top=Math.random()*100+"vh";

s.style.animationDuration=(Math.random()*3+1)+"s";

starBox.appendChild(s);

}

const emojis=[
"💖","💕","💗","💘","💝","❤️",
"🥰","😍","😘","🎉","🎂","🎈",
"🌹","✨","⭐","🌟","💐","🍰",
"🎁","💞","💓","💟","💜","🩷"
];

function createEmoji(){

let e=document.createElement("div");

e.className="emoji";

e.innerHTML=emojis[Math.floor(Math.random()*emojis.length)];

e.style.left=Math.random()*100+"vw";

e.style.bottom="-50px";

e.style.fontSize=(Math.random()*30+20)+"px";

e.style.animationDuration=(Math.random()*4+4)+"s";

document.body.appendChild(e);

setTimeout(()=>{
e.remove();
},8000);

}

setInterval(createEmoji,120);

</script>

</body>
</html>
